{
  "name": "experience-service",
  "version": "0.1.0",
  "description": "TravelPlatform Experience Service - Search, Book, Hold, Confirm, Cancel, Trip Management",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "fastify --index src/server.ts --port 3000",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "fastify-cors": "^8.3.0",
    "fastify-secure-session": "^5.3.0",
    "fastify-type-provider-zod": "^2.0.0",
    "zod": "^3.23.0",
    "zod-openapi": "^2.0.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "kafkajs": "^2.2.0",
    "uuid": "^9.0.0",
    "jose": "^5.0.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.0",
    "otel-instrumentation-fastify": "^0.37.0",
    "openai": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "typescript": "^5.3.3",
    "ts-jest": "^29.1.0"
  }
}
