{
  "name": "@travelplatform/testing-framework",
  "version": "1.0.0",
  "description": "TravelPlatform Test Automation Framework - Phase 1 Happy-Path Tests",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:experience": "vitest run api/scenarios/experience",
    "test:content": "vitest run api/scenarios/content",
    "test:policy": "vitest run api/scenarios/policy",
    "test:payment": "vitest run api/scenarios/payment",
    "test:xct": "vitest run api/scenarios/xct",
    "test:ui": "vitest run ui/scenarios",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:coverage": "node scripts/run-e2e-coverage.mjs",
    "test:e2e:coverage:merge": "node scripts/merge-istanbul-coverage.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-istanbul": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^8.0.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.0.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^9.0.7"
  },
  "dependencies": {
    "supertest": "^6.3.3"
  },
  "keywords": [
    "testing",
    "automation",
    "api",
    "jest",
    "vitest",
    "supertest",
    "travelplatform"
  ],
  "author": "TravelPlatform QA",
  "license": "MIT"
}
