    "express-rate-limit": "^7.0.0",
    "joi": "^17.11.0",
    "jwt-simple": "^0.5.6",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "sequelize": "^6.35.1",
    "winston": "^3.11.0"
