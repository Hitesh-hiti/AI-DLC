                },
                {
                  "key": "price_max",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "availability",
                  "value": "all",
                  "disabled": true
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": false
                },
                {
                  "key": "limit",
                  "value": "20",
                  "disabled": false
                }
              ]
            },
            "description": "List all products with optional filtering, sorting, and pagination"
          }
