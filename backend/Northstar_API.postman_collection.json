        {
          "name": "Get Product by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Product has images\", function () {",
                  "    pm.expect(pm.response.json().data.images).to.be.an('array');",
                  "});",
                  "pm.test(\"Product has specifications\", function () {",
                  "    pm.expect(pm.response.json().data.specifications).to.be.an('object');",
                  "});"
                ]
              }
            }
